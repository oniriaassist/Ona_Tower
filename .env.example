# ------------------------------------------------------------
# ONA Towers - shared environment template
# Copy to .env for local backend/database work.
# In Vercel, add the production values in Project Settings.
# ------------------------------------------------------------

APP_NAME=ONA Towers API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO
AUTO_INIT_DB=false

# Local default (no external database required):
DATABASE_URL=sqlite+pysqlite:///./database/ona_towers.db

# Production on Vercel + Supabase:
# Use Supabase Transaction pooler (port 6543) for DATABASE_URL.
# Example only - copy the exact value from Supabase Dashboard -> Connect.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Use Direct connection or Session pooler (port 5432) for Alembic migrations.
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=

# Same-origin production requests do not need CORS. These are for separate local servers.
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
CORS_ORIGIN_REGEX=

ENQUIRY_RATE_LIMIT_COUNT=5
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=3600
DUPLICATE_ENQUIRY_WINDOW_SECONDS=120
MAX_MESSAGE_LENGTH=2000

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ONA Towers
SMTP_USE_TLS=true
SALES_NOTIFICATION_EMAIL=

ADMIN_EMAIL=admin@onatowers.dev
ADMIN_PASSWORD=ona-admin-local
ADMIN_NAME=ONA Administrator
ADMIN_ROLE=Administrator
ADMIN_DEPARTMENT=Administration
ADMIN_SESSION_SECRET=ona-local-development-secret
ADMIN_SESSION_HOURS=12

# Frontend calls the API through the same Vercel domain.
VITE_API_BASE_URL=/api

# Only needed by Docker/local Vite proxying; do not set on Vercel.
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8400
VITE_GOOGLE_MAPS_API_KEY=https://earth.google.com/web/data=MkEKPwo9CiExbzQ1QnBfVFJsa3hPZWNRRHhKb3JuY1RSdFdDOElXRnISFgoUMDYzNDJDRkNEMzQxNEI5QTdGRDQgAUICCABKCAjCo-fQBBAB

