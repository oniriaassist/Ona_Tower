# ------------------------------------------------------------
# ONA Towers - shared environment template
# Copy to .env for local development only. Never commit .env.
# Configure production secrets in Vercel Project Settings.
# ------------------------------------------------------------

APP_NAME=ONA Towers API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO
AUTO_INIT_DB=false

# Local development default:
DATABASE_URL=postgresql+psycopg://postgres.mubdlzurivcqufgjtqsv:Oniria_2026.@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.mubdlzurivcqufgjtqsv:Oniria_2026.@aws-1-eu-west-1.pooler.supabase.com:5432/postgres


CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
CORS_ORIGIN_REGEX=

ENQUIRY_RATE_LIMIT_COUNT=5
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=3600
DUPLICATE_ENQUIRY_WINDOW_SECONDS=120
MAX_MESSAGE_LENGTH=2000

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ONA Towers
SMTP_USE_TLS=true
SALES_NOTIFICATION_EMAIL=

ADMIN_EMAIL=admin@onatowers.dev
ADMIN_PASSWORD=ona-admin-local
ADMIN_NAME=ONA Administrator
ADMIN_ROLE=Administrator
ADMIN_DEPARTMENT=Administration
ADMIN_SESSION_SECRET=ona-local-development-secret
ADMIN_SESSION_HOURS=12

VITE_API_BASE_URL=/api
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8400

# A Google Maps JavaScript API key, not a Google Earth URL.
VITE_GOOGLE_MAPS_API_KEY=
