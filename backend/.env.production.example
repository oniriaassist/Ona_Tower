APP_ENV=production
APP_DEBUG=false
API_PREFIX=/api
AUTO_INIT_DB=false

# Copy your exact Supabase Transaction pooler URL (6543), with an encoded password.
DATABASE_URL=

# Required: actual administrator email and a unique password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=ONA Administrator
ADMIN_ROLE=Administrator
ADMIN_DEPARTMENT=Administration
# Required: unique random secret of at least 32 characters.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12

# Same-origin traffic needs no additional CORS origin.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Set VITE_API_BASE_URL=/api in the Vercel project.
# Keep MIGRATION_DATABASE_URL and VITE_BACKEND_PROXY_TARGET local only.
