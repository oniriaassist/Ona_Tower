APP_ENV=production
APP_DEBUG=false
API_PREFIX=/api
AUTO_INIT_DB=false

# Copy the exact Supabase pooler URL from Dashboard -> Connect.
# The application automatically adds sslmode=require for Supabase if omitted.
DATABASE_URL=

# Transactional email (recommended: Resend HTTPS API for Vercel)
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
EMAIL_TIMEOUT_SECONDS=12
SMTP_FROM_EMAIL=sales@onatowers.com
SMTP_FROM_NAME=ONA Towers
SALES_NOTIFICATION_EMAIL=onatowers@proton.me
CITYVIEW_URL=https://www.onatowers.com/cityview

# Optional SMTP fallback instead of Resend API
SMTP_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=ONA Administrator
ADMIN_ROLE=Administrator
ADMIN_DEPARTMENT=Administration
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12

CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Frontend uses same-origin /api.
# Keep MIGRATION_DATABASE_URL and VITE_BACKEND_PROXY_TARGET local only.
