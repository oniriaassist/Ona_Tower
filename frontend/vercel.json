{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ona-tower-api.vercel.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://ona-tower-api.vercel.app/health"
    },
    {
      "source": "/health/:path*",
      "destination": "https://ona-tower-api.vercel.app/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
